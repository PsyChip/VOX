    "tiktoken": "^1.0.17",
    "ua-parser-js": "^2.0.6",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.1",
    "copy-webpack-plugin": "^11.0.0",
    "webpack": "^5.88.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "engines": {
    "node": ">=18"
